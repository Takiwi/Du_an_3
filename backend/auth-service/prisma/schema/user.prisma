enum STATUS {
  PENDING
  ACTIVE
  BANNED
  DEACTIVATED
}

enum ROLE {
    USER
    ADMIN
}

model User{
    id String @id
    username String @db.VarChar(255)
    email String @unique @db.VarChar(255)
    password String @db.VarChar(255)
    status STATUS
    role ROLE
    refreshToken RefreshToken[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("Users")
}
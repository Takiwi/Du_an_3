enum Status {
    COMING_SOON
    CURRENT_SHOWING
    COMPLETED
}

enum Type {
    TV_SHOW
    MOVIE
    OVE
    SPECIAL
}

enum Season {
    Spring
    Summer
    Fall
    Winter
}

model Anime {
  id          String   @id
  title       String
  description String? @db.Text
  status      Status   @default(COMING_SOON)
  type        Type  @default(MOVIE)

  relationFrom AnimeRelation[] @relation("FromAnime")
  relationTo AnimeRelation[] @relation("ToAnime")

  categories AnimeCategory[]
  releaseDate DateTime?
  season     Season 

  views        Int      @default(0)
  rating      Float  @default(0)

  isPublished Boolean @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([title, releaseDate])
  @@map("Anime")
}
